{
  "http_ports": "8080",

  "AllowedHosts": "*",

  "FeatureManagement": {
    "CustomOption": true
  },

  "ConnectionStrings": {
    "Default": "Data Source=data.db;Pooling=True;Foreign Keys=True"
  },

  "Auth": {
    "ExpireMinutes": 1440,
    "InitialAccount": {
      "Id": "admin",
      "Password": "admin"
    }
  },

  "Storage": {
    "Root": "storage"
  },

  "ForwardedHeaders": {
    "KnownNetworks": [],
    "KnownProxies": [],
    "ForwardLimit": 1
  },

  "Compression": {
    "Response": true,
    "Request": false
  },

  "Csp": {
    "ReportOnly": false
  },

  "Log": {
    "HttpLog": false,
    "HttpDump": false,
    "HttpDumpLimit": 4096,
    "W3CLog": {
      "Enable": false,
      "Directory": "../log",
      "FileName": "access-",
      "RetainedFileCount": 4
    }
  },

  "Profiler": {
    "SqlLog": {
      "Enable": false,
      "OutputParameter": true,
      "ElapsedThresholdMilliseconds": 0
    },
    "SqlTelemetry": {
      "Enable": false
    }
  },

  "Notification": {
    "Enable": false,
    "IntervalSeconds": 60
  },

  "ServerStatus": {
    "Enable": true,
    "IntervalSeconds": 2
  },

  "NotificationRetention": {
    "Enable": true,
    "IntervalMinutes": 60,
    "Days": 30,
    "BatchSize": 1000
  },

  "Prometheus": {
    "Uri": "http://0.0.0.0:9464"
  },

  "Telemetry": {
    "LongExecutionThreshold": 5000
  },

  "Serilog": {
    "Using": [
      "Serilog.Enrichers.Environment",
      "Serilog.Sinks.File"
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.HttpLogging": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "../log/Template.BlazorServer.Host_.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} {Level:u4} {MachineName} [{SourceContext}] [{ThreadId}] {TraceId} {RequestId} {RequestPath} - {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
