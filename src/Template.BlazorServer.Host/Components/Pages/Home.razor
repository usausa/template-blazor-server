@page "/"
@attribute [Authorize]
@inherits AppComponentBase

<PageTitle>Home</PageTitle>

<MudText Typo="Typo.h4">Home</MudText>
<MudText Class="mt-2">Template.BlazorServer</MudText>
<MudText Class="mt-2">接続中の回線: @circuitCount</MudText>

@if (featureEnabled)
{
    <MudChip T="string" Color="Color.Success" Class="mt-4">Feature: CustomOption 有効</MudChip>
}

@if (!String.IsNullOrEmpty(lastNotification))
{
    <MudAlert Severity="Severity.Info" Class="notification-alert mt-4">@lastNotification</MudAlert>
}
