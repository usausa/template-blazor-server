@page "/data"
@attribute [Authorize]

<PageTitle>Data</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Data</MudText>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudTextField @bind-Value="SearchName"
                  Label="名前"
                  Clearable="true"
                  Immediate="true"
                  OnKeyDown="OnSearchKeyDown"
                  Class="search-field" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="SearchAsync">検索</MudButton>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileDownload" Href="@ExportUrls.DataCsv">CSV</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PictureAsPdf" Href="@ExportUrls.InvoicePdf(false)" Target="_blank">PDF</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">追加</MudButton>
</MudStack>

<MudDataGrid @ref="grid" T="DataEntity" ServerData="LoadServerData" SortMode="SortMode.Single" Dense="true" @bind-CurrentPage="CurrentPage" @bind-RowsPerPage="RowsPerPage">
    <Columns>
        <PropertyColumn Property="x => x.Id" Title="ID" />
        <PropertyColumn Property="x => x.Name" Title="名前" />
        <PropertyColumn Property="x => x.Value" Title="値" />
        <PropertyColumn Property="x => x.CreatedAt" Title="作成日時">
            <CellTemplate>@FormatCreatedAt(context.Item)</CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="操作" CellClass="w-120" Sortable="false">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditAsync(context.Item)" />
                <AuthorizeView Roles="@Roles.Administrator" Context="auth">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context.Item)" />
                </AuthorizeView>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="DataEntity" />
    </PagerContent>
</MudDataGrid>
