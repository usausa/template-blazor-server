<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    @foreach (var group in Groups)
    {
        <MudNavGroup @key="group.Title" Title="@group.Title" Icon="@group.Icon" Expanded="@IsExpanded(group)" ExpandedChanged="@(value => OnExpandedChanged(group, value))">
            @foreach (var item in group.Items)
            {
                <Condition Value="@(item.Role is null)">
                    <ChildContent>
                        <MudNavLink Href="@item.Href">@item.Text</MudNavLink>
                    </ChildContent>
                    <ElseContent>
                        <AuthorizeView Roles="@item.Role">
                            <MudNavLink Href="@item.Href">@item.Text</MudNavLink>
                        </AuthorizeView>
                    </ElseContent>
                </Condition>
            }
        </MudNavGroup>
    }
</MudNavMenu>
